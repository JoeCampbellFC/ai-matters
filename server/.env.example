# Base URL of the iManage MCP Work connector for your tenant.
# Default (no custom subdomain): https://cloudimanage.com/mcp/work
# Custom subdomain example:       https://<tenant>.cloudimanage.com/mcp/work
IMANAGE_MCP_URL=https://cloudimanage.com/mcp/work

# Must be registered/allowed as an OAuth redirect URI for your iManage MCP
# client. iManage requires HTTPS here, including for local development --
# see ../README.md for how to generate a local dev certificate.
OAUTH_REDIRECT_URL=https://localhost:5173/api/auth/callback

# Origin of the frontend dev server, used for CORS and for post-auth
# redirects back into the app.
FRONTEND_URL=https://localhost:5173

# Long, random value used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

PORT=8787

# Azure OpenAI, used by the Phase 2 matter-research agent. Optional: Phase 1
# auth/workspace features work without these. Uses Azure's v1 API (no
# api-version needed) -- the endpoint is the resource root, e.g.
# https://<resource>.openai.azure.com (no trailing path).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Phase 3: Azure OpenAI Decisions API (matter classification). Requires a
# gpt-6-luna model deployment on the same resource/key above -- Decisions API
# deployments are model-specific, so this is separate from the deployment
# used for Phase 2 summarisation. Leave the default unless your tenant named
# the deployment something else.
AZURE_OPENAI_DECISIONS_DEPLOYMENT_NAME=gpt-6-luna

# Review thresholds (0-1) for the classification confidence returned by the
# Decisions API. Provisional defaults -- calibrate against human-labelled
# matters before relying on them for anything beyond a UI hint.
# CLASSIFICATION_HIGH_CONFIDENCE=0.85
# CLASSIFICATION_REVIEW_THRESHOLD=0.65

# Char budget for the full Matter Knowledge Markdown before classification
# falls back to a deterministic reduced extract.
# CLASSIFICATION_MAX_INPUT_CHARS=60000

# Phase 4: PostgreSQL connection. Local dev: a plain password against a
# locally installed/Dockerized Postgres. Azure: DATABASE_AUTH_MODE=entra uses
# the App Service's managed identity (via @azure/identity) instead of a
# password -- DATABASE_PASSWORD is ignored in that mode.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_matters
DATABASE_USER=ai_matters_dev
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_AUTH_MODE=password

# Identifies which iManage tenant this deployment serves (IMANAGE_MCP_URL is
# one URL per deployment) -- used as matters.tenant_id so workspace ids are
# never assumed globally unique across iManage environments.
TENANT_ID=dev-tenant
