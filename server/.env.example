# Base URL of the iManage MCP Work connector for your tenant.
# Default (no custom subdomain): https://cloudimanage.com/mcp/work
# Custom subdomain example:       https://<tenant>.cloudimanage.com/mcp/work
IMANAGE_MCP_URL=https://cloudimanage.com/mcp/work

# Must be registered/allowed as an OAuth redirect URI for your iManage MCP
# client. iManage requires HTTPS here, including for local development --
# see ../README.md for how to generate a local dev certificate.
OAUTH_REDIRECT_URL=https://localhost:5173/api/auth/callback

# Origin of the frontend dev server, used for CORS and for post-auth
# redirects back into the app.
FRONTEND_URL=https://localhost:5173

# Long, random value used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

PORT=8787

# Azure OpenAI, used by the Phase 2 matter-research agent. Optional: Phase 1
# auth/workspace features work without these. Uses Azure's v1 API (no
# api-version needed) -- the endpoint is the resource root, e.g.
# https://<resource>.openai.azure.com (no trailing path).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
